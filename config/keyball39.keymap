#define DEFAULT 0
#define NUM     1
#define SYM     2
#define FUN     3
#define MOUSE   4
#define SCROLL  5
#define SNIPE   6

#include <behaviors/mouse_keys.dtsi>
#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

&lt {
    tapping-term-ms = <240>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

&mt {
    tapping-term-ms = <200>;
    flavor = "tap-preferred";
    quick-tap-ms = <150>;
};

&caps_word { continue-list = <UNDERSCORE MINUS>; };

/ {
    // custom shift using mod-morph 

    behaviors {
        cmqus: comma_question {
            compatible = "zmk,behavior-mod-morph";
            label = "COMMA_QUESTION";
            #binding-cells = <0>;
            bindings = <&kp COMMA>, <&kp QUESTION>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        dtsmi: dot_semi {
            compatible = "zmk,behavior-mod-morph";
            label = "DOT_SEMI";
            #binding-cells = <0>;
            bindings = <&kp DOT>, <&kp SEMI>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <130>;
            flavor = "tap-preferred";
        };

        td_pgup_pgdn: td_pgup_pgdn {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_PGUP_PGDN";
            #binding-cells = <0>;
            bindings = <&none>;
        };

        ht: hold_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLD_TAP";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <170>;
        };
    };

    macros {
        Hiragana: Hiragana {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(SPACE)>;
            label = "HIRAGANA";
        };

        bt_in_out: bluetooth {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 0 &out OUT_TOG>;
            label = "BLUETOOTH";
        };
    };

    combos {
        compatible = "zmk,combos";

        enter_r {
            bindings = <&kp ENTER>;
            key-positions = <16 17>;
        };

        enter_l {
            bindings = <&kp ENTER>;
            key-positions = <12 13>;
        };

        del_r {
            bindings = <&kp DELETE>;
            key-positions = <7 8>;
        };

        del_l {
            bindings = <&kp DELETE>;
            key-positions = <22 23>;
        };

        bsp_r {
            bindings = <&kp BACKSPACE>;
            key-positions = <6 7>;
        };

        bsp_l {
            bindings = <&kp BACKSPACE>;
            key-positions = <21 22>;
        };

        tab {
            bindings = <&kp TAB>;
            key-positions = <10 11>;
            layers = <0>;
        };

        Caps {
            bindings = <&kp CAPSLOCK>;
            key-positions = <20 21>;
        };

        esc {
            bindings = <&kp ESCAPE>;
            key-positions = <0 1>;
        };

        Ralt {
            bindings = <&kp RIGHT_ALT>;
            key-positions = <16 18>;
        };

        OSL {
            bindings = <&sl 3>;
            key-positions = <11 12 13>;
            layers = <0>;
        };

        shift_home {
            bindings = <&kp LS(HOME)>;
            key-positions = <6 7>;
            layers = <1>;
        };

        shift_end {
            bindings = <&kp LS(END)>;
            key-positions = <7 7 8>;
            layers = <1>;
        };

        ctrl_left {
            bindings = <&kp LC(LEFT_ARROW)>;
            key-positions = <16 17>;
            layers = <1>;
        };

        ctrl_right {
            bindings = <&kp LC(RIGHT)>;
            key-positions = <17 18>;
            layers = <1>;
        };

        space {
            bindings = <&kp SPACE>;
            key-positions = <23 24>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            label = "QWRT";
            bindings = <
&lt 5 GRAVE  &lt 6 W     &kp E        &kp R             &kp T                               &kp Y  &kp U             &kp I        &kp O       &kp BSPC
&kp Q        &hm LALT S  &hm LCTRL D  &hm LEFT_SHIFT F  &kp G                               &kp H  &hm LEFT_SHIFT J  &hm LCTRL K  &hm LALT L  &kp P
&kp A        &kp X       &kp C        &kp V             &kp B                               &kp N  &kp M             &kp COMMA    &kp DOT     &kp SEMI
&kp Z        &kp LSHFT   &mo 2        &mo 1             &kp LCTRL  &kp LEFT_ALT  &kp SPACE  &mo 1                                             &kp FSLH
            >;
        };

        navi_layer {
            label = "NAVI";
            bindings = <
&kp F2     &kp F2     &kp F3         &kp F4                    &kp F5                            &kp LEFT_PARENTHESIS  &kp HOME        &kp UP_ARROW   &kp END      &none
&kp F2     &kp LC(S)  &kp LC(PG_UP)  &hm PAGE_DOWN LEFT_SHIFT  &kp LEFT_BRACKET                  &kp LEFT_BRACKET      &kp LEFT_ARROW  &kp DOWN       &kp RIGHT    &ht LC(PG_UP) PG_UP
&kp LC(A)  &kp LC(X)  &kp LC(C)      &kp LC(V)                 &kp LC(B)                         &kp LESS_THAN         &kp LS(HOME)    &kp LS(ENTER)  &kp LS(END)  &ht LC(PAGE_DOWN) PAGE_DOWN
&kp LC(Z)  &trans     &trans         &trans                    &trans            &trans  &trans  &trans                                                            &none
            >;
        };

        num {
            bindings = <
&none         &bt BT_CLR_ALL  &bt_in_out    &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS                  &kp PLUS        &kp N7  &kp N8  &kp N9  &ht UNDERSCORE MINUS
&none         &none           &none         &kp LEFT_BRACKET      &kp RIGHT_BRACKET                      &kp ASTERISK    &kp N4  &kp N5  &kp N6  &kp SLASH
&bt BT_SEL 0  &bt BT_SEL 1    &bt BT_SEL 2  &kp LESS_THAN         &kp GREATER_THAN                       &kp UNDERSCORE  &kp N1  &kp N2  &kp N3  &kp EQUAL
&none         &trans          &none         &kp PERIOD            &kp COMMA              &trans  &trans  &kp N0                                  &none
            >;

            label = "num";
        };

        osl_layer {
            label = "OSL";
            bindings = <
&none          &kp F23           &kp F22           &kp LG(R)         &kp LS(F2)                    &none   &none  &none  &none  &none
&kp LC(GRAVE)  &kp LG(NUMBER_1)  &kp LG(NUMBER_2)  &kp LG(NUMBER_3)  &kp LS(F3)                    &none   &none  &none  &none  &none
&kp LC(GRAVE)  &kp F19           &kp F20           &kp F18           &kp LG(HOME)                  &none   &none  &none  &none  &none
&kp F21        &trans            &trans            &trans            &trans        &trans  &trans  &trans                       &trans
            >;
        };

        mouse_layer {
            label = "MOUSE";
            bindings = <
&kp N1          &kp N2          &kp N3        &kp N4     &kp N5                        &kp N6         &kp N7     &kp N8  &kp N9     &kp N0
&kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT  &none                         &kp PAGE_UP    &mkp LCLK  &none   &mkp RCLK  &mkp MCLK
&none           &none           &none         &none      &none                         &kp PAGE_DOWN  &none      &none   &none      &none
&none           &trans          &trans        &mkp LCLK  &mkp RCLK  &mkp MCLK  &trans  &mo 3                                        &none
            >;
        };

        scroll_layer {
            label = "SCROLL";
            bindings = <
&trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans                          &trans
            >;
        };

        snipe_layer {
            label = "SNIPE";
            bindings = <
&trans  &trans  &trans  &trans  &bootloader                  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                       &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                       &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans       &trans  &trans  &trans                          &trans
            >;
        };

        symbol_layer {
            label = "SYM";
            bindings = <
&kp EXCLAMATION  &kp AT_SIGN   &kp HASH      &kp DOLLAR    &kp PERCENT                  &kp CARET       &kp AMPERSAND  &kp ASTERISK      &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
&bt BT_CLR       &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &trans                       &kp MINUS       &kp EQUAL      &kp LEFT_BRACKET  &kp RIGHT_BRACKET     &kp SQT
&trans           &trans        &trans        &trans        &trans                       &kp UNDERSCORE  &kp PLUS       &trans            &trans                &kp NON_US_BACKSLASH
&trans           &trans        &trans        &trans        &trans       &trans  &trans  &trans                                                                 &trans
            >;
        };
    };
};
