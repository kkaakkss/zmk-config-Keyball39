#define DEFAULT 0
#define NUM     1
#define SYM     2
#define FUN     3
#define MOUSE   4
#define SCROLL  5
#define SNIPE   6

#include <behaviors/mouse_keys.dtsi>
#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

&lt {
    tapping-term-ms = <240>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

&mt {
    tapping-term-ms = <200>;
    flavor = "tap-preferred";
    quick-tap-ms = <150>;
};

&caps_word { continue-list = <UNDERSCORE MINUS>; };

/ {
    // custom shift using mod-morph 

    behaviors {
        cmqus: comma_question {
            compatible = "zmk,behavior-mod-morph";
            label = "COMMA_QUESTION";
            #binding-cells = <0>;
            bindings = <&kp COMMA>, <&kp QUESTION>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        dtsmi: dot_semi {
            compatible = "zmk,behavior-mod-morph";
            label = "DOT_SEMI";
            #binding-cells = <0>;
            bindings = <&kp DOT>, <&kp SEMI>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        hrm_L: homerow_left {
            compatible = "zmk,behavior-hold-tap";
            label = "Homerow_L";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <5 6 7 8 9 15 16 17 18 19 25 26 27 28 29 37 38 36>;
        };

        td_pgup_pgdn: td_pgup_pgdn {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_PGUP_PGDN";
            #binding-cells = <0>;
            bindings = <&none>;
        };

        ht: hold_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "Hold_Tap";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <170>;
        };

        hrm_r: homerow_right {
            compatible = "zmk,behavior-hold-tap";
            label = "Homerow_R";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 30 31 32 33 34 35>;
        };

        alt_q_1: alt_q_1 {
            compatible = "zmk,behavior-mod-morph";
            label = "ALT_Q_1";
            bindings = <&kp Q>, <&kp NUMBER_1>;

            #binding-cells = <0>;
            mods = <(MOD_LALT)>;
            keep-mods = <(MOD_LALT)>;
        };

        alt_w_2: alt_w_2 {
            compatible = "zmk,behavior-mod-morph";
            label = "ALT_W_2";
            bindings = <&kp W>, <&kp NUMBER_2>;

            #binding-cells = <0>;
            mods = <(MOD_LALT)>;
            keep-mods = <(MOD_LALT)>;
        };

        alt_e_3: alt_e_3 {
            compatible = "zmk,behavior-mod-morph";
            label = "ALT_E_3";
            bindings = <&kp E>, <&kp NUMBER_3>;

            #binding-cells = <0>;
            mods = <(MOD_LALT)>;
            keep-mods = <(MOD_LALT)>;
        };

        new_behavior: new_behavior {
            compatible = "zmk,behavior-mod-morph";
            label = "NEW_BEHAVIOR";
            bindings = <&kp R>, <&kp NUMBER_4>;

            #binding-cells = <0>;
            mods = <(MOD_LALT)>;
            keep-mods = <(MOD_LALT)>;
        };

        alt_r_4: alt_r_4 {
            compatible = "zmk,behavior-mod-morph";
            label = "ALT_R_4";
            bindings = <&kp R>, <&kp NUMBER_4>;

            #binding-cells = <0>;
            mods = <(MOD_LALT)>;
            keep-mods = <(MOD_LALT)>;
        };

        alt_t_5: alt_t_5 {
            compatible = "zmk,behavior-mod-morph";
            label = "ALT_T_5";
            bindings = <&kp T>, <&kp NUMBER_5>;

            #binding-cells = <0>;
            mods = <(MOD_LALT)>;
            keep-mods = <(MOD_LALT)>;
        };

        as_tab: as_tab {
            compatible = "zmk,behavior-mod-morph";
            label = "AS_TAB";
            bindings = <&kp TAB>, <&kp LS(LA(TAB))>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL|MOD_LALT)>;
        };
    };

    macros {
        Hiragana: Hiragana {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(SPACE)>;
            label = "HIRAGANA";
        };

        bt_in_out: bluetooth {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 0 &out OUT_TOG>;
            label = "BLUETOOTH";
        };

        alt_Lclick: alt_click {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LALT &mkp LCLK>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&mkp LCLK &kp LEFT_ALT>;

            label = "ALT_CLICK";
        };

        alt_Rclick: alt_Rclick {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LALT &mkp RCLK>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&mkp RCLK &kp LEFT_ALT>;

            label = "ALT_RCLICK";
        };
    };

    combos {
        compatible = "zmk,combos";

        enter_r {
            bindings = <&kp ENTER>;
            key-positions = <16 17>;
            layers = <0>;
        };

        enter_l {
            bindings = <&kp ENTER>;
            key-positions = <12 13>;
            layers = <0>;
        };

        del_r {
            bindings = <&kp DELETE>;
            key-positions = <7 8>;
            layers = <0>;
        };

        del_l {
            bindings = <&kp DELETE>;
            key-positions = <22 23>;
            layers = <0>;
        };

        bsp_r {
            bindings = <&kp BACKSPACE>;
            key-positions = <6 7>;
            layers = <0>;
        };

        bsp_l {
            bindings = <&kp BACKSPACE>;
            key-positions = <21 22>;
            layers = <0>;
        };

        as_tab {
            bindings = <&as_tab>;
            key-positions = <10 11>;
            layers = <0>;
        };

        Caps {
            bindings = <&kp CAPSLOCK>;
            key-positions = <20 21>;
            layers = <0>;
        };

        esc {
            bindings = <&kp ESCAPE>;
            key-positions = <0 1>;
            layers = <0>;
        };

        Ralt {
            bindings = <&kp RIGHT_ALT>;
            key-positions = <16 18>;
            layers = <0>;
        };

        OSL {
            bindings = <&sl 3>;
            key-positions = <11 12 13>;
            layers = <0>;
        };

        shift_home {
            bindings = <&kp LS(HOME)>;
            key-positions = <6 7>;
            layers = <1>;
        };

        shift_end {
            bindings = <&kp LS(END)>;
            key-positions = <8 7>;
            layers = <1>;
        };

        ctrl_left {
            bindings = <&kp LC(LEFT_ARROW)>;
            key-positions = <16 17>;
            layers = <1>;
        };

        ctrl_right {
            bindings = <&kp LC(RIGHT)>;
            key-positions = <17 18>;
            layers = <1>;
        };

        space {
            bindings = <&kp SPACE>;
            key-positions = <23 24>;
            layers = <0>;
        };

        mouse_l {
            bindings = <&mkp LCLK>;
            key-positions = <16 17>;
            layers = <4>;
        };

        mouse_r {
            bindings = <&mkp RCLK>;
            key-positions = <17 18>;
            layers = <4>;
        };

        mouse_m {
            bindings = <&mkp MCLK>;
            key-positions = <16 17 18>;
            layers = <4>;
        };

        tab2 {
            bindings = <&kp TAB>;
            key-positions = <11 12>;
            layers = <0>;
        };

        esc2 {
            bindings = <&kp ESCAPE>;
            key-positions = <1 2>;
            layers = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            label = "QWERTY";
            bindings = <
&alt_q_1        &alt_w_2      &alt_e_3        &alt_r_4             &alt_t_5                            &kp Y        &kp U                &kp I           &kp O    &kp P
&kp A           &lt 7 S       &hrm_L LCTRL D  &hrm_L LEFT_SHIFT F  &kp G                               &kp H        &hrm_r LEFT_SHIFT J  &hrm_r LCTRL K  &lt 7 L  &kp SEMICOLON
&kp Z           &kp X         &kp C           &kp V                &kp B                               &kp N        &kp M                &kp COMMA       &kp DOT  &kp SLASH
&kp LEFT_SHIFT  &kp CAPSLOCK  &mo 2           &lt 1 SPACE          &kp LCTRL  &kp LEFT_ALT  &kp SPACE  &lt 2 SPACE                                                &kp RIGHT_ALT
            >;
        };

        navi_layer {
            label = "func & navi";
            bindings = <
&kp GRAVE             &kp F2     &kp F3             &kp F4           &kp F5                     &none   &kp HOME        &kp UP_ARROW   &kp END      &ht LC(HOME) PG_UP
&kp NON_US_BACKSLASH  &kp LC(S)  &kp LC(PAGE_DOWN)  &kp LC(PAGE_UP)  &none                      &none   &kp LEFT_ARROW  &kp DOWN       &kp RIGHT    &ht LC(END) PAGE_DOWN
&kp LC(Z)             &kp LC(X)  &kp LC(C)          &kp LC(V)        &kp LC(B)                  &none   &kp LS(HOME)    &kp LS(ENTER)  &kp LS(END)  &none
&trans                &trans     &trans             &trans           &trans     &trans  &trans  &trans                                              &none
            >;
        };

        bracket_num {
            bindings = <
&kp GRAVE             &bt BT_CLR_ALL  &bt_in_out    &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS                  &kp PLUS        &kp N7  &kp N8  &kp N9  &ht UNDERSCORE MINUS
&kt NON_US_BACKSLASH  &none           &none         &kp LEFT_BRACKET      &kp RIGHT_BRACKET                      &kp ASTERISK    &kp N4  &kp N5  &kp N6  &kp SLASH
&bt BT_SEL 0          &bt BT_SEL 1    &bt BT_SEL 2  &kp LESS_THAN         &kp GREATER_THAN                       &kp UNDERSCORE  &kp N1  &kp N2  &kp N3  &kp EQUAL
&trans                &trans          &trans        &kp PERIOD            &kp COMMA              &trans  &trans  &kp N0                                  &none
            >;

            label = "() & NUM";
        };

        osl_layer {
            label = "OSL";
            bindings = <
&none          &kp F23           &kp F22           &kp LG(R)         &kp LS(F2)                    &kp GRAVE         &kp AMPERSAND    &kp ASTERISK  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
&kp LC(GRAVE)  &kp LG(NUMBER_1)  &kp LG(NUMBER_2)  &kp LG(NUMBER_3)  &kp LS(F3)                    &kp LEFT_BRACKET  &kp DOLLAR       &kp PERCENT   &kp CARET             &kp RIGHT_BRACKET
&kp F21        &kp F19           &kp F20           &kp F18           &kp LG(HOME)                  &kp LESS_THAN     &kp EXCLAMATION  &kp AT_SIGN   &kp HASH              &kp GREATER_THAN
&trans         &trans            &trans            &trans            &trans        &trans  &trans  &trans                                                                 &kt UNDERSCORE
            >;
        };

        mouse_layer {
            label = "MOUSE";
            bindings = <
&none  &mo 5           &kp UP_ARROW    &mo 6        &none                              &none      &none           &msc SCRL_UP    &none            &none
&none  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT    &none                              &none      &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_RIGHT  &none
&none  &none           &none           &alt_Lclick  &alt_Rclick                        &none      &none           &none           &none            &none
&mo 5  &mo 6           &trans          &mkp MCLK    &mkp LCLK    &mkp RCLK  &mkp LCLK  &mkp RCLK                                                   &none
            >;
        };

        scroll_layer {
            label = "SCROLL";
            bindings = <
&trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans                          &trans
            >;
        };

        snipe_layer {
            label = "SNIPE";
            bindings = <
&trans  &trans  &trans  &trans  &bootloader                  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                       &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                       &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans       &trans  &trans  &trans                          &trans
            >;
        };

        pinky_layer {
            label = "PINKY";
            bindings = <
&trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans         &trans     &trans
&trans  &kp Q   &kp A   &kp Z   &trans                  &trans  &kp P   &kp SEMICOLON  &kp SLASH  &trans
&trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans         &trans     &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans                                    &trans
            >;
        };
    };
};
